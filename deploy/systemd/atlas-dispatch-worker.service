[Unit]
Description=ATLAS DISPATCH scheduled delivery worker (single run)
After=network.target
Wants=network.target

[Service]
Type=oneshot
User=atlas
WorkingDirectory=/opt/atlas-lens
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/atlas/atlas.env
ExecStart=/opt/atlas-lens/.venv/bin/python -m app.dispatch.worker --process-due
